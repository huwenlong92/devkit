#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEVKIT_ROOT="${DEVKIT:-$SCRIPT_ROOT}"
if [ ! -d "$DEVKIT_ROOT/config/starship/themes" ] && [ -d "$SCRIPT_ROOT/config/starship/themes" ]; then
  DEVKIT_ROOT="$SCRIPT_ROOT"
fi
THEME_DIR="${DEVKIT_STARSHIP_THEME_DIR:-$DEVKIT_ROOT/config/starship/themes}"
TARGET_CONFIG="${DEVKIT_STARSHIP_CONFIG:-$DEVKIT_ROOT/config/starship.toml}"

print_message() {
  local icon="$1"
  local label="$2"
  local value="${3:-}"
  local color="${4:-32}"
  local bold=""
  local reset=""

  if [ -t 1 ]; then
    bold=$'\033[1m'
    reset=$'\033[0m'
    printf '%s  \033[%sm%s%s%s' "$icon" "$color" "$bold" "$label" "$reset"
  else
    printf '%s  %s' "$icon" "$label"
  fi

  if [ -n "$value" ]; then
    printf '  %s' "$value"
  fi
  printf '\n'
}

print_error() {
  print_message "❌" "$1" "${2:-}" 31 >&2
}

show_help() {
  cat <<'EOF'
starship-theme - DevKit Starship 主题管理

Usage:
  starship-theme list
  starship-theme use <theme>
  starship-theme current
  starship-theme show <theme>
  starship-theme path
  starship-theme -h | --help | help

Examples:
  starship-theme list
  starship-theme use default
  starship-theme show compact
EOF
}

validate_theme() {
  local file="$1"

  if grep -q '^404: Not Found$' "$file"; then
    return 1
  fi

  if command -v starship >/dev/null 2>&1; then
    local cache_dir="${XDG_CACHE_HOME:-${TMPDIR:-/tmp}/devkit-starship-cache}"
    mkdir -p "$cache_dir"
    XDG_CACHE_HOME="$cache_dir" STARSHIP_CONFIG="$file" starship print-config >/dev/null
    return
  fi
}

theme_file() {
  local name="$1"
  case "$name" in
    *[!A-Za-z0-9._-]*|"")
      return 1
      ;;
  esac
  printf '%s/%s.toml\n' "$THEME_DIR" "$name"
}

list_themes() {
  if [ ! -d "$THEME_DIR" ]; then
    print_error "No theme directory" "$THEME_DIR"
    exit 1
  fi

  local found=0
  local current
  current="$(detect_current || true)"

  for file in "$THEME_DIR"/*.toml; do
    [ -e "$file" ] || continue
    found=1
    name="$(basename "$file" .toml)"
    marker=" "
    [ "$name" = "$current" ] && marker="*"

    if validate_theme "$file" >/dev/null 2>&1; then
      if [ "$marker" = "*" ]; then
        print_message "★" "$name" "current" 32
      else
        print_message " " "$name" "" 36
      fi
    else
      print_message "!" "$name" "invalid" 31
    fi
  done

  if [ "$found" -eq 0 ]; then
    print_error "No themes found" "$THEME_DIR"
    exit 1
  fi
}

detect_current() {
  [ -f "$TARGET_CONFIG" ] || return 1

  for file in "$THEME_DIR"/*.toml; do
    [ -e "$file" ] || continue
    if cmp -s "$TARGET_CONFIG" "$file"; then
      basename "$file" .toml
      return 0
    fi
  done

  echo "custom"
}

use_theme() {
  local name="$1"
  local file
  if ! file="$(theme_file "$name")"; then
    print_error "Invalid theme name" "$name"
    exit 1
  fi

  if [ ! -f "$file" ]; then
    print_error "Theme not found" "$name"
    print_message "👉" "Try" "starship-theme list" 36 >&2
    exit 1
  fi

  if ! validate_theme "$file"; then
    print_error "Invalid Starship theme" "$name"
    print_message "📄" "Theme file" "$file" 33 >&2
    exit 1
  fi

  mkdir -p "$(dirname "$TARGET_CONFIG")"
  cp "$file" "$TARGET_CONFIG"
  print_message "✅" "Starship theme" "$name" 32
  print_message "📄" "Config" "$TARGET_CONFIG" 36
}

show_theme() {
  local name="$1"
  local file
  if ! file="$(theme_file "$name")"; then
    print_error "Invalid theme name" "$name"
    exit 1
  fi

  if [ ! -f "$file" ]; then
    print_error "Theme not found" "$name"
    exit 1
  fi

  cat "$file"
}

case "${1:-}" in
  --help|-h|help|"")
    show_help
    ;;
  list|ls)
    list_themes
    ;;
  use|switch)
    if [ $# -lt 2 ]; then
      print_error "Missing theme name"
      print_message "👉" "Usage" "starship-theme use <theme>" 36 >&2
      exit 1
    fi
    use_theme "$2"
    ;;
  current)
    detect_current || echo "default"
    ;;
  show)
    if [ $# -lt 2 ]; then
      print_error "Missing theme name"
      print_message "👉" "Usage" "starship-theme show <theme>" 36 >&2
      exit 1
    fi
    show_theme "$2"
    ;;
  path)
    printf 'themes: %s\nconfig: %s\n' "$THEME_DIR" "$TARGET_CONFIG"
    ;;
  *)
    print_error "Unknown command" "$1"
    show_help >&2
    exit 1
    ;;
esac
