#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEVKIT_ROOT="${DEVKIT:-$SCRIPT_ROOT}"

print_message() {
  local icon="$1"
  local label="$2"
  local value="${3:-}"
  local color="${4:-32}"
  local bold=""
  local reset=""

  if [ -t 1 ]; then
    bold=$'\033[1m'
    reset=$'\033[0m'
    printf '%s  \033[%sm%s%s%s' "$icon" "$color" "$bold" "$label" "$reset"
  else
    printf '%s  %s' "$icon" "$label"
  fi

  if [ -n "$value" ]; then
    printf '  %s' "$value"
  fi
  printf '\n'
}

print_error() {
  print_message "❌" "$1" "${2:-}" 31 >&2
}

show_help() {
  cat <<'EOF'
devkit - DevKit 工具箱管理命令

Usage:
  devkit refresh
  devkit path
  devkit -h | --help | help

Commands:
  refresh  在 DevKit 目录执行 git pull --ff-only
  path     显示当前 DevKit 目录

Environment:
  DEVKIT  DevKit 安装目录，默认当前 devkit 命令所在目录

Examples:
  devkit refresh
  devkit path
EOF
}

ensure_devkit_root() {
  local root="$1"

  if [ ! -d "$root/.git" ] || [ ! -d "$root/bin" ] || [ ! -d "$root/shell" ]; then
    print_error "Not a DevKit git root" "$root"
    exit 1
  fi
}

refresh_devkit() {
  ensure_devkit_root "$DEVKIT_ROOT"

  git -C "$DEVKIT_ROOT" pull --ff-only

  echo
  print_message "✅" "DevKit updated" "$DEVKIT_ROOT" 32
  print_message "👉" "Reload current shell" "" 36
  printf '  source %q\n' "$DEVKIT_ROOT/shell/index.zsh"
}

case "${1:-}" in
  --help|-h|help|"")
    show_help
    ;;
  refresh|update|sync)
    refresh_devkit
    ;;
  path)
    printf '%s\n' "$DEVKIT_ROOT"
    ;;
  *)
    print_error "Unknown command" "$1"
    show_help >&2
    exit 1
    ;;
esac
