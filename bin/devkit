#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEVKIT_ROOT="${DEVKIT:-$SCRIPT_ROOT}"
COMMAND_NAME="${DEVKIT_COMMAND_NAME:-$(basename "$0")}"

print_message() {
  local icon="$1"
  local label="$2"
  local value="${3:-}"
  local color="${4:-32}"
  local bold=""
  local reset=""

  if [ -t 1 ]; then
    bold=$'\033[1m'
    reset=$'\033[0m'
    printf '%s  \033[%sm%s%s%s' "$icon" "$color" "$bold" "$label" "$reset"
  else
    printf '%s  %s' "$icon" "$label"
  fi

  if [ -n "$value" ]; then
    printf '  %s' "$value"
  fi
  printf '\n'
}

print_error() {
  print_message "❌" "$1" "${2:-}" 31 >&2
}

show_help() {
  cat <<EOF
${COMMAND_NAME} - DK 工具箱管理命令

Usage:
  ${COMMAND_NAME} refresh
  ${COMMAND_NAME} commands
  ${COMMAND_NAME} path
  ${COMMAND_NAME} -h | --help | help

Commands:
  refresh  在 DK 目录执行 git pull --ff-only
  commands 列出 DK 提供的常用命令
  path     显示当前 DK 目录

Environment:
  DEVKIT  DK 安装目录，默认当前 ${COMMAND_NAME} 命令所在目录

Examples:
  ${COMMAND_NAME} refresh
  ${COMMAND_NAME} commands
  ${COMMAND_NAME} path
EOF
}

show_commands() {
  cat <<'EOF'
DK commands

Core:
  dk help                         Show DK help
  dk commands                     Show this command list
  dk refresh                      Pull latest DK and reload shell
  dk path                         Print DK path

Codex / AI:
  cx <prompt>                     Codex with proxy auto-detect
  cxr <prompt>                    Codex read-only mode
  cxf <prompt>                    Codex fix mode
  cxs <prompt>                    Codex SQL review mode
  cxv <prompt>                    Codex code review mode
  codex ...                       Codex via default fnm Node version
  claude ...                      Claude Code via proxy and default fnm Node

Proxy:
  proxy help                      Show proxy help
  proxy on [port]                 Enable HTTP/SOCKS proxy env
  proxy off                       Disable proxy env
  proxy status                    Show proxy env status
  proxy auto [--off]              Auto-enable proxy if local port is available
  proxy check                     Check external IP through DK proxy
  vpncheck                        Check external IP without forcing DK proxy
  ipcheck                         Show local and external IP info
  p <command>                     Run one command with proxy env
  pon / poff / psx / pauto        Short aliases for proxy on/off/status/auto
  pcheck / vcheck / myip          Short aliases for proxy check/vpncheck/ipcheck
  start_forward / stop_forward    Manage local proxy port forwarding

Docker:
  devkit-docker help              Show Docker shortcut help
  dkd help                        Short alias for devkit-docker help
  redis74 / r74                   Redis 7.4 CLI in home Docker context
  pg14 / p14                      PostgreSQL 14 psql in home Docker context
  pg18 / p18                      PostgreSQL 18 psql in home Docker context
  pg18dump / p18dump              Dump PostgreSQL 18 database
  pg18restore / p18restore        Restore PostgreSQL 18 dump
  contabo-redis / cr74            Redis CLI in contabo Docker context
  contabo-pg18 / cpg18            PostgreSQL 18 psql in contabo Docker context
  cpg18dump / cpg18restore        Dump/restore Contabo PostgreSQL 18

SSH / DB tunnel:
  vispp-db help                   Show tunnel help
  vispp-db start                  Start PostgreSQL SSH tunnel
  vispp-db status                 Show tunnel status
  vispp-db stop                   Stop tunnel

Ghostty:
  gty help                        Show Ghostty helper help
  gty status                      Show Ghostty integration status
  gty edit                        Edit Ghostty config
  gty ssh <target>                SSH with compatible TERM
  gty install-terminfo <target>   Install Ghostty terminfo remotely

Shell helpers:
  ls / ll / la / lt               eza-backed listings when eza is installed
  starship-theme                  Switch local Starship theme

More detail:
  proxy help
  devkit-docker help
  gty help
  vispp-db help
EOF
}

ensure_devkit_root() {
  local root="$1"

  if [ ! -d "$root/.git" ] || [ ! -d "$root/bin" ] || [ ! -d "$root/shell" ]; then
    print_error "Not a DevKit git root" "$root"
    exit 1
  fi
}

refresh_devkit() {
  ensure_devkit_root "$DEVKIT_ROOT"

  git -C "$DEVKIT_ROOT" pull --ff-only

  echo
  print_message "✅" "DK updated" "$DEVKIT_ROOT" 32
  print_message "👉" "Reload current shell" "" 36
  printf '  source %q\n' "$DEVKIT_ROOT/shell/index.zsh"
}

case "${1:-}" in
  --help|-h|help|"")
    show_help
    ;;
  commands|cmds|list|ls)
    show_commands
    ;;
  refresh|update|sync)
    refresh_devkit
    ;;
  path)
    printf '%s\n' "$DEVKIT_ROOT"
    ;;
  *)
    print_error "Unknown command" "$1"
    show_help >&2
    exit 1
    ;;
esac
